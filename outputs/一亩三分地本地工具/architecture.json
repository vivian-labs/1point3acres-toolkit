  "owners": {
    "settings.py": "部署、账号身份、站点地址、默认值、限额及导出文件名",
    "contracts.py": "任务/动作/内容状态、会话诊断契约与每日奖励动作定义",
    "browser.py": "在线会话与站点请求；其他模块不得另建网络实现",
    "library.py": "资料数据库写入；调用方不直接操作 SQLite",
    "interact.py": "用户逐项指定的论坛互动（收藏等）：目标状态操作，先读后写再回读；每日任务与资料库不带站点副作用",
    "presentation.py": "阅读器文案和业务状态到展示状态的映射",
    "tokens.css": "唯一视觉取值集合",
    "reader.css": "复用 token 的界面组件样式",
    "reader.js": "界面交互，消费展示数据，不重建业务判定",
    "architecture.json": "模块、依赖、接口和视觉数量预算；扩大范围须同步主方案说明理由",
    "repository_checks.py": "版本化文件边界、敏感信息特征与测试分组登记检查；不读取账号状态",
    "check.py": "唯一离线检查入口：阶段选择、依赖校验、测试执行、脱敏报告和 CI 汇总",
    "entry.py": "安装版入口：pip / uvx 装好后的两个命令；启动前恢复平铺布局，不含任何业务逻辑",
    "pyproject.toml": "PyPI 打包元数据：包名、版本、依赖锁定、入口命令、目录映射；依赖与入口以本文件和 settings 为准",
    "server.json": "MCP 官方目录的登记条目：名字、版本、PyPI 包；版本必须与 pyproject.toml 一致",
    "corpus.py": "离线语料提取、来源校验、文案选择与近似重复判定；不联网、不提交站点",
    "updates.py": "唯一软件更新来源、CI 准入、独立版本及依赖环境准备和原子激活；不访问论坛",
    "launcher.py": "稳定启动入口，更新检查后以新解释器执行 CLI 或常驻 MCP 代理",
    "mcp_bridge.py": "保持 MCP 连接和请求生命周期，在调用间隙替换后台版本，不重放业务调用"
  },
